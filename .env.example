# ==============================================================================
# 1. PAYPAL SANDBOX CREDENTIALS (Role A - Engine / Reconciler)
# Create a REST App in https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# Required for local live runs: Playwright approves a Sandbox order as this buyer.
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=your_sandbox_buyer_password
# Reserved for future signature-verification work; current F6 shop does not verify signatures.
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ==============================================================================
# 2. DRIFTGUARD ENGINE & INFRASTRUCTURE (Role A)
# ==============================================================================
# PostgreSQL for run storage; the current API launches runs with FastAPI background tasks.
POSTGRES_USER=driftguard
POSTGRES_PASSWORD=driftguard
POSTGRES_DB=driftguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://driftguard:driftguard@localhost:5432/driftguard

# DriftGuard FastAPI Orchestrator Service
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
ENGINE_BASE_URL=http://localhost:8000
# Extra CORS origins for the hosted deploy (comma-separated, no spaces).
# DRIFTGUARD_CORS_ORIGINS=https://driftguard.onrender.com

# mitmproxy Interceptor Configuration
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_WEB_PORT=8081
PROXY_LOG_PATH=./logs/proxy_traffic.jsonl
USE_PROXY=true

# Fault Injection Settings
DRIFTGUARD_FAULT=F1

# ==============================================================================
# 3. DEMO SHOP / TARGET APP (Role B - Demo Target)
# ==============================================================================
DEMO_SHOP_PORT=3001
DEMO_SHOP_URL=http://localhost:3001

# ==============================================================================
# 4. AI & EXTERNAL SERVICES (Roles B & C)
# ==============================================================================
# Optional model providers for scenario generation, fixer proposals, and explanations.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional Groq provider.
GROQ_API_KEY=your_groq_api_key_here
# Optional Anthropic provider for the local Studio and fixer.
# Set an account/workspace spend limit in Anthropic Console before using a key.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Which providers the Fixer and Explainer try, in order. "gemini,groq" is free (default),
# "anthropic,gemini,groq" is for the demo, and "none" uses no model (curated patch + template text).
DRIFTGUARD_LLM=gemini,groq
# Local/trusted demo only: execute a generated or curated code patch in a disposable
# shop copy, then reconcile a fresh PayPal Sandbox order. Keep off on public hosts:
# the patched Node process is not a security sandbox.
DRIFTGUARD_ENABLE_FIX_RERUN=0
# Stop calling Anthropic once this much is spent. Tracked per machine in logs/llm_spend.json.
ANTHROPIC_SPEND_LIMIT_USD=1.50

# Optional development-time APIMatic context; not a runtime dependency.
APIMATIC_API_KEY=your_apimatic_api_key_here

# For the Vite browser build, configure VITE_AG_STUDIO_KEY in dashboard/.env.local
# if you have an AG Studio license. Never put model or PayPal secrets there.

# ==============================================================================
# 5. GENERAL RUNTIME
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info
