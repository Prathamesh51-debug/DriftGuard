{
  "$defs": {
    "Expectation": {
      "additionalProperties": false,
      "description": "Deterministic ground-truth rules expected after test execution.",
      "properties": {
        "captures_per_purchase": {
          "default": 1,
          "description": "Expected captures recorded by PayPal",
          "minimum": 0,
          "title": "Captures Per Purchase",
          "type": "integer"
        },
        "amount": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected total amount as strict decimal string, e.g. '38.97'",
          "title": "Amount"
        },
        "currency": {
          "default": "USD",
          "description": "Currency code, e.g. 'USD'",
          "title": "Currency",
          "type": "string"
        },
        "no_refund_issued": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True if prompt injection must not issue unverified refund",
          "title": "No Refund Issued"
        }
      },
      "title": "Expectation",
      "type": "object"
    },
    "FaultType": {
      "description": "The 7 official fault scenarios injected by DriftGuard.",
      "enum": [
        "F1_LOST_CAPTURE_RESPONSE",
        "F2_SLOW_PAYPAL",
        "F3_FORCED_DECLINE",
        "F4_DUPLICATE_INVOICE",
        "F5_MONEY_MATH_TRAP",
        "F6_WEBHOOK_REPLAY",
        "F7_PROMPT_INJECTION"
      ],
      "title": "FaultType",
      "type": "string"
    },
    "InjectAction": {
      "additionalProperties": false,
      "description": "Configuration for mitmproxy interceptor to inject faults into PayPal traffic.",
      "properties": {
        "on": {
          "description": "Pattern matching PayPal endpoint, e.g. 'POST .../capture'",
          "title": "On",
          "type": "string"
        },
        "action": {
          "description": "Action to perform, e.g. 'drop_response_after_upstream', 'delay', 'mock_response'",
          "title": "Action",
          "type": "string"
        },
        "mock_header": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Header value for PayPal-Mock-Response (e.g. INSTRUMENT_DECLINED)",
          "title": "Mock Header"
        },
        "delay_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Delay duration in milliseconds for slow proxy simulation",
          "title": "Delay Ms"
        },
        "payload": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extra metadata or custom payload for webhook/prompt attacks",
          "title": "Payload"
        }
      },
      "required": [
        "on",
        "action"
      ],
      "title": "InjectAction",
      "type": "object"
    },
    "TargetCall": {
      "additionalProperties": false,
      "description": "Points to the exact code location intercepted in the target repo.",
      "properties": {
        "file": {
          "description": "Path to the source file relative to repo root",
          "title": "File",
          "type": "string"
        },
        "line": {
          "description": "1-based line number of the PayPal SDK call",
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SDK method name or route, e.g. OrdersController.captureOrder",
          "title": "Method"
        }
      },
      "required": [
        "file",
        "line"
      ],
      "title": "TargetCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scenario Contract (Input to Role A Engine).\nGenerated by Role B scanner and scenario generator.",
  "properties": {
    "scenario_id": {
      "description": "Unique scenario identifier, e.g. 'f1-capture-lost-001'",
      "title": "Scenario Id",
      "type": "string"
    },
    "fault": {
      "$ref": "#/$defs/FaultType",
      "description": "Fault type enum"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable scenario explanation",
      "title": "Description"
    },
    "target_call": {
      "$ref": "#/$defs/TargetCall",
      "description": "Target PayPal call site in the application code"
    },
    "inject": {
      "$ref": "#/$defs/InjectAction",
      "description": "Proxy fault injection specifications"
    },
    "expect": {
      "$ref": "#/$defs/Expectation",
      "description": "Deterministic expectations verified by Reconciler"
    }
  },
  "required": [
    "scenario_id",
    "fault",
    "target_call",
    "inject",
    "expect"
  ],
  "title": "Scenario",
  "type": "object"
}