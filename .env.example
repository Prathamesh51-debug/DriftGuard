# ==============================================================================
# 1. PAYPAL SANDBOX CREDENTIALS (Role A - Engine / Reconciler)
# Create a REST App in https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com

# (Optional: Used by Role C for headless Playwright buyer automation)
PAYPAL_SANDBOX_BUYER_EMAIL=sb-buyer@personal.example.com
PAYPAL_SANDBOX_BUYER_PASSWORD=your_sandbox_buyer_password
# (Optional: Used for F6 Webhook verification)
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# ==============================================================================
# 2. DRIFTGUARD ENGINE & INFRASTRUCTURE (Role A)
# ==============================================================================
# PostgreSQL for SKIP LOCKED orchestrator queue
POSTGRES_USER=driftguard
POSTGRES_PASSWORD=driftguard
POSTGRES_DB=driftguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql://driftguard:driftguard@localhost:5432/driftguard

# DriftGuard FastAPI Orchestrator Service
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
ENGINE_BASE_URL=http://localhost:8000

# mitmproxy Interceptor Configuration
PROXY_HOST=127.0.0.1
PROXY_PORT=8080
PROXY_WEB_PORT=8081
PROXY_LOG_PATH=./logs/proxy_traffic.jsonl

# Fault Injection Settings
DRIFTGUARD_FAULT=F1 # F1 | ALL

# ==============================================================================
# 3. DEMO SHOP / TARGET APP (Role B - Demo Target)
# ==============================================================================
DEMO_SHOP_PORT=3001
DEMO_SHOP_URL=http://localhost:3001

# ==============================================================================
# 4. AI & EXTERNAL SERVICES (Roles B & C)
# ==============================================================================
# LLM API key for tree-sitter flow mapping, scenario generation, and fixer diffs (Roles B & C)
# Google Gemini provides a free tier at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alternative with free fast inference (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
# Optional paid provider for final runs and the demo (https://console.anthropic.com/).
# Set a spend limit on the key in the console.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Which providers the Fixer and Explainer try, in order. "gemini,groq" is free (default),
# "anthropic,gemini,groq" is for the demo, and "none" uses no model (curated patch + template text).
DRIFTGUARD_LLM=gemini,groq
# Stop calling Anthropic once this much is spent. Tracked per machine in logs/llm_spend.json.
ANTHROPIC_SPEND_LIMIT_USD=1.50

# APIMatic Context Plugin for SDK patch synthesis (Role C)
APIMATIC_API_KEY=your_apimatic_api_key_here

# AG Studio / Dashboard Deployment (Role C)
AG_STUDIO_KEY=your_ag_studio_key_here

# ==============================================================================
# 5. GENERAL RUNTIME
# ==============================================================================
NODE_ENV=development
LOG_LEVEL=info